{
  "name": "chm-reader-light",
  "version": "0.1.1",
  "description": "A lightweight offline CHM reader and library for macOS",
  "main": "build/main.js",
  "author": "liuqi.9867",
  "license": "MIT",
  "homepage": "https://github.com/zhongdiandaoda/chm-reader-light#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhongdiandaoda/chm-reader-light.git"
  },
  "bugs": {
    "url": "https://github.com/zhongdiandaoda/chm-reader-light/issues"
  },
  "keywords": [
    "chm",
    "chm-reader",
    "chm-viewer",
    "macos-chm-reader",
    "chm-reader-macos",
    "offline-docs",
    "offline-documentation",
    "html-help",
    "microsoft-html-help",
