    "electron",
    "ebook",
    "documentation",
    "macos",
    "macos-app",
    "reader"
  ],
  "type": "commonjs",
  "scripts": {
    "doctor": "bash scripts/doctor.sh",
    "run": "bash scripts/run.sh",
    "start": "electron .",
    "test": "node scripts/test.js",
    "benchmark:chm": "npm run build && node scripts/benchmark-chm.js",
    "build": "node scripts/build.js",
    "check": "npm run typecheck && npm run build && node --check build/main.js && node --check build/preload.js && node --check build/chm.js && node --check build/ipc-security.js && node --check build/navigation-security.js && node --check build/navigation.js && node --check build/library.js && node --check build/search-index-worker.js && npm run check:docs && npm run check:audit && npm run check:changelog && npm run check:metadata && npm run check:labels && npm run check:community && npm run check:assets && npm run check:release-template && npm run check:node-version && npm run check:license && npm run check:badges && npm run check:llms && npm run check:growth && npm run check:workflows && npm run check:templates",
    "check:docs": "node scripts/check-doc-links.js",
    "check:audit": "npm audit --audit-level=moderate --cache /tmp/chm-reader-npm-cache",
    "check:changelog": "node scripts/check-changelog.js",
    "check:metadata": "node scripts/check-repository-metadata.js",
    "check:remote-listing": "node scripts/check-live-repository-listing.js",
    "apply:repository-listing": "node scripts/apply-repository-listing.js",
    "check:labels": "node scripts/check-labels.js",
    "check:community": "node scripts/check-community-health.js",
    "check:assets": "node scripts/check-visual-assets.js",
    "generate:social-preview": "bash scripts/generate-social-preview.sh",
    "check:release-template": "node scripts/check-release-template.js",
    "check:node-version": "node scripts/check-node-version.js",
    "check:license": "node scripts/check-license.js",
    "check:badges": "node scripts/check-readme-badges.js",
    "check:llms": "node scripts/check-llms.js",
    "check:growth": "node scripts/check-growth-readiness.js",
    "check:workflows": "node scripts/check-workflows.js",
    "check:templates": "node scripts/check-github-templates.js",
    "check:release-artifacts": "node scripts/check-release-artifacts.js",
    "check:release-bundle:mac": "bash scripts/check-macos-release-bundle.sh",
    "check:chmlib:mac": "bash scripts/check-chmlib-macos.sh",
    "check:package:mac": "bash scripts/check-macos-package-env.sh arm64",
    "check:package:mac:arm64": "bash scripts/check-macos-package-env.sh arm64",
    "check:remote-release": "node scripts/check-live-release.js",
    "stage:release-artifacts": "node scripts/stage-release-artifacts.js",
    "prepare:release-body": "node scripts/prepare-release-body.js",
    "publish:release": "node scripts/publish-release.js",
    "snapshot:growth": "node scripts/snapshot-growth-metrics.js",
    "snapshot:visibility": "node scripts/snapshot-visibility-readiness.js",
    "prepare:visibility-issue": "node scripts/prepare-visibility-issue.js",
    "prepare:share-post": "node scripts/prepare-share-post.js",
    "typecheck": "tsc --noEmit",
    "clean": "bash scripts/clean.sh",
    "build:chmlib:mac:arm64": "bash scripts/build-chmlib-macos.sh arm64",
    "package:mac": "bash scripts/package-macos.sh arm64",
    "package:mac:arm64": "bash scripts/package-macos.sh arm64",
    "package:release:mac:arm64": "bash scripts/package-macos-release.sh arm64",
    "install:mac": "bash scripts/install-macos.sh arm64",
    "install:mac:arm64": "bash scripts/install-macos.sh arm64"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.6.0",
    "@electron/packager": "20.0.4",
    "@types/node": "^24.13.3",
    "electron": "43.2.0",
    "lint-staged": "16.2.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "htmlparser2": "10.1.0"
  },
  "engines": {
    "node": ">=22"
  }
