{
  "name": "chm-reader-light",
  "version": "0.1.0",
  "description": "A focused CHM reader for macOS",
  "main": "build/main.js",
  "author": "liuqi.9867",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "doctor": "bash scripts/doctor.sh",
    "run": "bash scripts/run.sh",
    "start": "electron .",
    "test": "node scripts/test.js",
    "benchmark:chm": "npm run build && node scripts/benchmark-chm.js",
    "build": "node scripts/build.js",
    "check": "npm run typecheck && npm run build && node --check build/main.js && node --check build/preload.js && node --check build/chm.js && node --check build/navigation.js && node --check build/library.js && node --check build/search-index-worker.js",
    "typecheck": "tsc --noEmit",
    "clean": "bash scripts/clean.sh",
    "package:mac": "bash scripts/package-macos.sh",
    "package:mac:arm64": "bash scripts/package-macos.sh arm64",
    "package:mac:x64": "bash scripts/package-macos.sh x64",
    "install:mac": "bash scripts/install-macos.sh",
    "install:mac:arm64": "bash scripts/install-macos.sh arm64",
    "install:mac:x64": "bash scripts/install-macos.sh x64"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@types/node": "^24.13.3",
    "electron": "43.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "htmlparser2": "10.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
