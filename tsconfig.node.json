{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": ".build-node",
    "noEmit": false
  },
  "include": [
    "src/chm.ts",
    "src/library.ts",
    "src/main.ts",
    "src/navigation.ts",
    "src/preload.ts",
    "src/search-index-worker.ts"
  ],
  "exclude": ["node_modules", "build", "dist", ".build-node"]
}
