{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": ".build-browser",
    "noEmit": false
  },
  "include": [
    "src/i18n.ts",
    "src/library.ts",
    "src/navigation.ts",
    "src/renderer.ts"
  ],
  "exclude": ["node_modules", "build", "dist", ".build-browser"]
}
